# ─────────────────────────────────────────────────────────────
# RentHub environment variables (Neon + Better Auth stack)
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon) ───────────────────────────────────────────
# Postgres connection string from Neon (Project → Connect).
# Server-only. NEVER prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Authentication (Better Auth) ─────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key
# Public URL of the app (used in emails + cookie configuration)
BETTER_AUTH_URL=http://localhost:3000
# Set to "true" to require email verification before login
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── App URL (emails, SEO canonical, redirects) ───────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Storage ──────────────────────────────────────────────────
# "local" (public/uploads, dev) — set BLOB_READ_WRITE_TOKEN to use Vercel Blob
STORAGE_PROVIDER=local
# Vercel Blob token (server-only). When set, uploads go to Blob.
BLOB_READ_WRITE_TOKEN=

# ── Payment provider — "mock" (sandbox) or "paystack" ────────
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── One-time admin bootstrap ─────────────────────────────────
# Required to create the first admin account (never public signup).
BOOTSTRAP_SECRET=

# ── Demo seed (dev) ──────────────────────────────────────────
# Optional guard for /api/demo/seed outside development.
DEMO_SEED_SECRET=

# ── Optional integrations ────────────────────────────────────
MAPS_API_KEY=
EMAIL_API_KEY=

# ── Optional cron guard for /api/cron/rent-overdue ───────────
CRON_SECRET=
